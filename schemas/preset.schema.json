{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvas-shaders.dev/schemas/preset.schema.json",
  "title": "EffectPreset",
  "type": "object",
  "required": [
    "name",
    "effectId",
    "params"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "effectId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "params": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
