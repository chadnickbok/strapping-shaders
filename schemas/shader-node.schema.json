{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvas-shaders.dev/schemas/shader-node.schema.json",
  "title": "ShaderNode",
  "type": "object",
  "required": [
    "id",
    "type",
    "effectId",
    "frame",
    "params"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "shader"
    },
    "effectId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "frame": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "type": "number",
          "default": 0
        }
      },
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "default": {}
    },
    "seed": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "exportOverrides": {
      "type": "object",
      "properties": {
        "quality": {
          "type": "string",
          "enum": [
            "auto",
            "high",
            "medium",
            "low"
          ]
        },
        "animate": {
          "type": "boolean"
        },
        "time": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
